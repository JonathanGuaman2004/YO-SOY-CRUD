# Puerto del CRUD de misiones
PORT=4000

# Seguridad solicitada en el taller
API_KEY_HEADER=X-FIS-EPN-KEY
FIS_EPN_API_KEY=fis-epn-2025
REQUIRE_API_KEY=true

# Persistencia local
MISSIONS_DB_PATH=./db/missions.sqlite

# Logs estructurados de auditoría
LOG_FILE_PATH=./logs/audit.log

# Integración con epn-event-manager
EVENT_MANAGER_URL=http://localhost:3000/events
EVENT_MANAGER_HEALTH_URL=http://localhost:3000/health
EVENT_MANAGER_TIMEOUT_MS=2500
SEND_EVENTS=true

# CORS: usar * para desarrollo local o una lista separada por comas
CORS_ORIGINS=*
